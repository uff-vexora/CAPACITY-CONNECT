# Required by the Render API service. Replace placeholder values in Render; do not commit real secrets.
MONGO_URI=mongodb://127.0.0.1:27017/capacity-connect
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Render provides PORT automatically. Local development may use 5000.
PORT=5000
# Required only when running `npm run seed`; it is not needed by Render at runtime.
SEED_TRAINER_PASSWORD=replace-with-a-demo-password
